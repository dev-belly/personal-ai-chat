{
  "name": "personal-ai-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "test": "node --test",
    "check:http": "node scripts/check-http.mjs",
    "check:text": "node scripts/check-text.mjs",
    "check": "npm run check:text && npm run typecheck && npm test && npm run build && npm run check:http && npm run build:worker",
    "start": "next start",
    "check:browser": "node scripts/check-browser.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.105",
    "@ai-sdk/openai-compatible": "3.0.92",
    "@streamdown/code": "2.0.0",
    "ai": "7.0.173",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "streamdown": "2.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "fake-indexeddb": "6.2.8",
    "playwright": "1.65.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "@opennextjs/cloudflare": {
      "glob": "14.0.6"
    },
    "@node-minify/core": {
      "glob": "14.0.6"
    },
    "form-data": "4.0.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.5",
    "express": {
      "body-parser": "2.4.0"
    },
    "undici": "7.30.1"
  },
  "type": "module"
}
